{
  "cleanUrls": false,
  "directoryListing": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/index",
      "destination": "/index.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/factura",
      "destination": "/factura.html"
    },
    {
      "source": "/cotizacion",
      "destination": "/cotizacion.html"
    },
    {
      "source": "/clientes",
      "destination": "/clientes.html"
    },
    {
      "source": "/historial",
      "destination": "/historial.html"
    },
    {
      "source": "/ingresos",
      "destination": "/ingresos.html"
    },
    {
      "source": "/detalle",
      "destination": "/detalle.html"
    },
    {
      "source": "/configuracion",
      "destination": "/configuracion.html"
    },
    {
      "source": "/404",
      "destination": "/404.html"
    }
  ],
  "headers": [
    {
      "source": "**/*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
        }
      ]
    },
    {
      "source": "service-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
